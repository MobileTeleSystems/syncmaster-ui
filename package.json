{
  "name": "syncmaster_ui",
  "version": "0.3.7",
  "private": true,
  "description": "Frontend for SyncMaster",
  "license": "Apache-2.0",
  "packageManager": "yarn@4.8.1",
  "type": "commonjs",
  "scripts": {
    "dev": "cross-env NODE_ENV=development webpack serve",
    "prod": "cross-env NODE_ENV=production webpack serve",
    "build": "rimraf ./dist && cross-env NODE_OPTIONS=--max_old_space_size=8192 && cross-env NODE_ENV=production webpack",
    "lint": "eslint --fix src",
    "lint-check": "eslint src",
    "type-check": "tsc --noEmit",
    "prettier": "prettier src --write --list-different",
    "prettier-check": "prettier src --check --list-different",
    "bundle-analyze": "cross-env BUNDLE_ANALYZER=true cross-env NODE_ENV=production webpack --progress",
    "check": "yarn lint && yarn type-check",
    "pre-commit-install": "husky"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-devtools": "5.101.4",
    "@xyflow/react": "12.11.3",
    "ace-builds": "1.44.0",
    "antd": "4.24.16",
    "axios": "1.19.0",
    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "dotenv-webpack": "9.0.0",
    "i18next": "25.10.10",
    "rc-picker": "4.11.3",
    "react": "18.3.1",
    "react-ace": "14.1.0",
    "react-dom": "18.3.1",
    "react-error-boundary": "4.1.2",
    "react-i18next": "16.6.6",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@svgr/webpack": "8.1.0",
    "@types/node": "25.9.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "cross-env": "10.1.0",
    "css-loader": "7.1.4",
    "css-minimizer-webpack-plugin": "8.0.0",
    "eslint": "9.39.5",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "html-webpack-plugin": "5.6.8",
    "husky": "9.1.7",
    "less": "4.9.0",
    "less-loader": "12.3.3",
    "lint-staged": "16.4.0",
    "mini-css-extract-plugin": "2.10.2",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "style-loader": "4.0.0",
    "terser-webpack-plugin": "5.6.1",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "webpack": "5.109.2",
    "webpack-bundle-analyzer": "5.3.1",
    "webpack-cli": "7.2.2",
    "webpack-dev-server": "5.2.6",
    "webpack-merge": "6.0.1"
  },
  "engines": {
    "node": ">18",
    "npm": ">10"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx,json,css,less}": "prettier --write --list-different",
    "src/**/*.{ts,tsx}": "eslint --fix"
  }
}
